{
  "name": "audio-annotation-workbench",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "pnpm --dir web dev",
    "format": "pnpm --dir web format",
    "format:check": "pnpm --dir web format:check",
    "lint": "pnpm --dir web lint",
    "typecheck": "pnpm --dir web typecheck",
    "test": "pnpm --dir web test",
    "build": "pnpm --dir web build",
    "validate": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build"
  }
}
